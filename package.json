{
  "name": "nicknotes",
  "private": true,
  "description": "Lokale Markdown-NoteBase mit Tasks, Wissensgraph und MCP",
  "author": "Niklas Richter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevNiklasRichter/NickNotes.git"
  },
  "homepage": "https://github.com/DevNiklasRichter/NickNotes",
  "bugs": {
    "url": "https://github.com/DevNiklasRichter/NickNotes/issues"
  },
  "version": "2.1.0-rc.4",
  "main": "src/desktop/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev:backend": "python -m src.backend.server",
    "build": "tsc -b && vite build",
    "readme:media": "node scripts/capture-readme-media.mjs",
    "lint": "eslint src/frontend/src",
    "preview": "vite preview",
    "test:frontend": "vitest run --root src/frontend",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "test:desktop": "node --test scripts/capture-draft-store.test.mjs scripts/vite-readiness.test.mjs scripts/window-close-guard.test.mjs scripts/update-service.test.mjs scripts/backend-worker.test.mjs scripts/release-policy.test.mjs scripts/release-prepare.test.mjs scripts/ci-scope.test.mjs",
    "test": "npm run test:frontend && npm run test:backend && npm run test:desktop",
    "check": "npm test && npm run lint && npm run build",
    "build:backend": "node scripts/build-backend.mjs",
    "stage:app": "node scripts/stage-app.mjs",
    "package:win": "npm run build && npm run build:backend && npm run stage:app && electron-builder --win --publish never",
    "package:dir": "npm run build && npm run build:backend && npm run stage:app && electron-builder --dir --publish never",
    "package:release": "node scripts/package-release.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:validate": "node scripts/release-policy.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:draft": "node scripts/release-draft.mjs --upload",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:commands": "node scripts/smoke-commands.mjs",
    "smoke:startup": "node scripts/smoke-startup.mjs",
    "smoke:updates": "node scripts/smoke-updates.mjs",
    "ux:baseline": "node scripts/capture-ux-baseline.mjs",
    "benchmark:startup": "node scripts/measure-startup.mjs",
    "icons:generate": "node scripts/generate-icon-names.mjs",
    "icons:check": "node scripts/generate-icon-names.mjs --check",
    "release:checksums": "node scripts/release-checksums.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "cytoscape": "^3.35.0",
    "electron-updater": "6.8.11",
    "lucide-react": "^1.72.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "7.8.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.1"
  }
}
